# TidyOS Environment Configuration Example
# Copy this file to .env and configure as needed.

# AI Provider Selection (openai or openrouter)
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Configuration (Alternative Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging Configuration
TIDYOS_LOG_LEVEL=INFO
TIDYOS_LOG_TO_CONSOLE=true
TIDYOS_LOG_TO_FILE=true

# Application Storage & Data Directory (defaults to user AppData/Local/TidyOS if not set)
# TIDYOS_DATA_DIR=./data

# Autonomous Organizer Settings
TIDYOS_CONFIDENCE_THRESHOLD=0.85
TIDYOS_WATCHER_ENABLED=true
TIDYOS_WATCHER_DEBOUNCE_SECONDS=2.0
