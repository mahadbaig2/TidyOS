# TidyOS Environment Configuration Example
# Copy this file to .env and configure as needed.

# OpenAI API Key (Required for multimodal vision & LLM reasoning; deterministic features work offline)
OPENAI_API_KEY=your_openai_api_key_here

# Logging Configuration
TIDYOS_LOG_LEVEL=INFO
TIDYOS_LOG_TO_CONSOLE=true
TIDYOS_LOG_TO_FILE=true

# Application Storage & Data Directory (defaults to user AppData/Local/TidyOS if not set)
# TIDYOS_DATA_DIR=./data

# Autonomous Organizer Settings
TIDYOS_CONFIDENCE_THRESHOLD=0.85
TIDYOS_WATCHER_ENABLED=true
TIDYOS_WATCHER_DEBOUNCE_SECONDS=2.0
